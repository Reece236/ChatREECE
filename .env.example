# Copy to .env and fill in. Everything here is optional except ADMIN_KEY,
# which you really should set yourself before going live.

# Port the server listens on.
PORT=3000

# Your key. This is the only thing you type to get into the answering desk at /admin.
# Use the same two-word style as your visitors, but longer, e.g. "harbor-drifting-quietly-8412".
# If you leave this blank the server generates one on first boot and writes it to data/admin-key.txt.
ADMIN_KEY=

# Where the SQLite file and generated admin key live.
DATA_DIR=./data

# Set to 1 when running behind a reverse proxy (Render, Fly, Railway, nginx, Cloudflare).
# Needed so login cookies get the Secure flag and rate limiting sees real client IPs.
TRUST_PROXY=0

# Digits on the end of a generated key. 3 is the default and is ~100x harder to guess
# than 2 while being just as easy to type. Minimum 2, maximum 4.
KEY_DIGITS=3

# Optional. Any URL that accepts a JSON POST (Slack incoming webhook, Discord webhook,
# your own endpoint). Fired when someone asks a new question so you know to come answer.
NOTIFY_WEBHOOK_URL=

# Optional. Shown to visitors on the login screen and in the chat header.
SITE_NAME=ChatREECE
OWNER_NAME=Reece

# Optional. Comma-separated list of origins allowed to embed the widget iframe.
# Leave blank to allow same-origin only. Example: https://reece.io,https://www.reece.io
EMBED_ORIGINS=
