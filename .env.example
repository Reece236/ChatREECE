# Copy to .env and fill in. Everything is optional except ADMIN_KEY, which you
# should set yourself before going live.

# Port the server listens on.
PORT=3000

# Your key. The only thing you type to get into the answering desk at /admin.
# Visitors use a username and password; this is just for you.
# If you leave it blank, one is generated on first boot and written to
# data/admin-key.txt.
ADMIN_KEY=

# Where the SQLite file, the pepper and the generated admin key live.
DATA_DIR=./data

# Set to 1 behind a reverse proxy (Fly, Render, Railway, nginx, Cloudflare).
# Needed so login cookies get the Secure flag and rate limiting sees real
# client IPs rather than the proxy's.
TRUST_PROXY=0

# Shown to people on the sign-in screen and in the chat.
SITE_NAME=ChatREECE
OWNER_NAME=Reece

# Comma-separated origins allowed to embed the widget in an iframe.
# Leave blank for same-origin only. Example: https://reece.io,https://www.reece.io
EMBED_ORIGINS=

# --- Notifications ---------------------------------------------------------
# Push notifications work out of the box: signing keys are generated on first
# boot and stored in the database, so they survive restarts.
#
# A contact address is part of the web push standard — push services use it to
# reach you if your notifications start misbehaving.
PUSH_CONTACT=mailto:you@example.com

# Only set these if you want to pin your own signing keys (generate a pair with
# `npx web-push generate-vapid-keys`). Changing them invalidates every existing
# subscription, so people would have to turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional. Any URL that accepts a JSON POST (Slack or Discord incoming
# webhook, or your own endpoint), fired when a new question arrives.
NOTIFY_WEBHOOK_URL=
